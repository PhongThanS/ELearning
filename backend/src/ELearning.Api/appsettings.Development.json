{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ELearningDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      }
    ]
  }
}
