{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ELearningDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "Auth": {
    "AllowSelfRegistration": true
  },
  "Seed": {
    "AdminPassword": "Admin@123456",
    "DevPassword": "Student@123456"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
