{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "ELearning",
    "Audience": "ELearning.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "AllowSelfRegistration": false,
    "LockoutMaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshReuseGraceSeconds": 30
  },
  "App": {
    "BusinessTimeZone": "Asia/Ho_Chi_Minh",
    "PublicOrigin": "http://localhost:5173"
  },
  "Exam": {
    "SubmitGraceSeconds": 30,
    "ExpirationSweepIntervalSeconds": 60,
    "ExpirationSweepBatchSize": 100
  },
  "RateLimits": {
    "AuthLoginPerMinute": 600,
    "AuthRefreshPerMinute": 1200,
    "AttemptWriteBurst": 20,
    "AttemptWritePerMinute": 60,
    "AttemptActionPerMinute": 10,
    "DefaultPerMinute": 300
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@elearning.local"
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
