# Sao chép thành .env rồi sửa. KHÔNG commit .env (đã có trong .gitignore).
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# --- SQL Server ---
# Mật khẩu sa: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt
SQL_SA_PASSWORD=Change_Me_Sa#2026
# Express (miễn phí, giới hạn 10 GB) | Standard | Enterprise | Developer (không dùng cho production)
MSSQL_PID=Express
DB_NAME=ELearningDb
# Tài khoản ứng dụng (chỉ đọc / ghi dữ liệu), tạo bởi deploy/sql/init-app-login.sql
APP_DB_LOGIN=elearning_app
APP_DB_PASSWORD=Change_Me_App#2026
# Thư mục trên máy chủ chứa file backup (gắn vào /var/opt/mssql/backup)
BACKUP_DIR=./backups
# Thư mục trên máy chủ chứa ảnh câu hỏi (gắn vào API tại /var/lib/elearning/media; backup.sh sao lưu vào BACKUP_DIR/media)
MEDIA_DIR=./media

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Tối thiểu 32 byte, ngẫu nhiên
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# Mật khẩu admin khởi tạo; bắt buộc đổi ở lần đăng nhập đầu
ADMIN_INITIAL_PASSWORD=Change_Me_Admin#2026
ALLOW_SELF_REGISTRATION=false

# --- Web ---
HTTP_PORT=8080
# Origin công khai (dùng kiểm tra Origin cho cookie refresh). Production: https://<domain>
PUBLIC_ORIGIN=http://localhost:8080
# Chỉ dùng với docker-compose.prod.yml (HTTPS)
SERVER_NAME=elearning.example.vn
CERT_DIR=./deploy/certs

# Tag image khi build / triển khai
IMAGE_TAG=local

# --- Giám sát (docs/09-van-hanh.md mục 7) ---
# Webhook nhận cảnh báo (Slack / Mattermost / Google Chat / Teams). Rỗng: cảnh báo chỉ nằm trong log của container monitor.
ALERT_WEBHOOK_URL=
# Tên trường văn bản của webhook: text (Slack, Mattermost, Google Chat, Teams) hoặc content (Discord)
ALERT_WEBHOOK_FIELD=text
# Tên môi trường ghi ở đầu mỗi cảnh báo, ví dụ production / staging
ALERT_ENV_NAME=production
# Cảnh báo khi không có file backup mới: full quá 26 giờ, log quá 30 phút (theo lịch ở deploy/scripts/backup.sh).
# Để rỗng nếu chưa đặt lịch backup.
BACKUP_FULL_MAX_AGE_HOURS=26
BACKUP_LOG_MAX_AGE_MINUTES=30
