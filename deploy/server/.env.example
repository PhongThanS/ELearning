# Máy chủ chạy image dựng sẵn (deploy/server/README.md). Sao chép thành .env rồi sửa. KHÔNG commit .env (đã có trong .gitignore).
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Change_Me_Postgres#2026
DB_NAME=elearning_db
# Thư mục trên máy chủ chứa file backup
BACKUP_DIR=./backups
# Thư mục trên máy chủ chứa ảnh câu hỏi (gắn vào API tại /var/lib/elearning/media)
MEDIA_DIR=./media

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Tối thiểu 32 byte, ngẫu nhiên
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# Mật khẩu admin khởi tạo; bắt buộc đổi ở lần đăng nhập đầu
ADMIN_INITIAL_PASSWORD=Change_Me_Admin#2026
ALLOW_SELF_REGISTRATION=false

# --- Web ---
HTTP_PORT=80
# Origin công khai (dùng kiểm tra Origin cho cookie refresh). Production: https://<domain>
PUBLIC_ORIGIN=http://localhost
# Chỉ dùng với docker-compose.prod.yml (HTTPS)
SERVER_NAME=elearning.example.vn
CERT_DIR=./certs

# Nơi lấy image và phiên bản: latest = bản mới nhất của nhánh main; sha-xxxxxxx = đúng một commit (để quay lại bản cũ)
IMAGE_REGISTRY=ghcr.io/phongthans
IMAGE_TAG=latest
# Dải IP mạng nội bộ của các container; chỉ đổi khi trùng với mạng có sẵn trên máy
DOCKER_SUBNET=172.28.0.0/24

# --- Giám sát (docs/09-van-hanh.md mục 7) ---
# Webhook nhận cảnh báo (Slack / Mattermost / Google Chat / Teams). Rỗng: cảnh báo chỉ nằm trong log của container monitor.
ALERT_WEBHOOK_URL=
# Tên trường văn bản của webhook: text (Slack, Mattermost, Google Chat, Teams) hoặc content (Discord)
ALERT_WEBHOOK_FIELD=text
# Tên môi trường ghi ở đầu mỗi cảnh báo, ví dụ production / staging
ALERT_ENV_NAME=production
# Cảnh báo khi không có file backup mới: full quá 26 giờ, log quá 30 phút (theo lịch ở deploy/scripts/backup.sh).
# Để rỗng nếu chưa đặt lịch backup (mặc định ở đây: rỗng).
BACKUP_FULL_MAX_AGE_HOURS=
BACKUP_LOG_MAX_AGE_MINUTES=

# --- Cloudflare Tunnel (tùy chọn, deploy/server/README.md mục 6) ---
# Bỏ dấu # ở dòng COMPOSE_PROFILES và dán token của tunnel để chạy kèm dịch vụ "tunnel".
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
